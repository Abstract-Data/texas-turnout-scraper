# Early-vote ingest image (ADR-017): the package with the waf and loader extras, run by the
# Durable Object in infra/ev_ingest. Build context is the repo root.
FROM python:3.12-slim

RUN pip install --no-cache-dir uv==0.13.5

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH=/app/.venv/bin:$PATH

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
RUN uv sync --locked --no-dev --no-install-project --extra waf --extra loader

COPY src ./src
COPY data/geo/tx_geo.json ./data/geo/tx_geo.json
COPY scripts/ev_ingest_steps.sh ./scripts/ev_ingest_steps.sh
RUN uv sync --locked --no-dev --extra waf --extra loader

CMD ["sleep", "infinity"]
